#!/usr/bin/env ruby
# Writes config/chef.yml, which enables each Chef cop that Cookstyle enables by default.
#
# House style sets `AllCops: DisabledByDefault: true`, which turns off every cop that a
# config does not enable by name, so enabling the Chef departments is not enough.
# Run this with the Ruby that runs Cookstyle after each Cookstyle upgrade.

require "yaml"

spec = Gem::Specification.find_by_name("cookstyle")
defaults = YAML.load_file(File.join(spec.gem_dir, "config", "cookstyle.yml"))

cops = defaults.select do |name, config|
  name.start_with?("Chef/") && name.count("/") == 2 && config.is_a?(Hash) && config["Enabled"]
end

File.open(File.expand_path("../config/chef.yml", __dir__), "w") do |file|
  file.puts "# Generated by bin/generate-chef-config from Cookstyle #{spec.version}. Do not edit."
  cops.keys.sort.each do |name|
    file.puts
    file.puts "#{name}:"
    file.puts "  Enabled: true"
  end
end

puts "Enabled #{cops.size} Chef cops from Cookstyle #{spec.version}"
